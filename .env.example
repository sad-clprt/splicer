# Modal — authentication via `modal token new` (stored in ~/.modal.toml)
# No env vars required; optionally set MODAL_ENVIRONMENT
# MODAL_ENVIRONMENT=main

# HuggingFace (for model downloads)
HUGGINGFACE_ACCESS_TOKEN=hf_...

# TMDB
TMDB_API_KEY=...
TMDB_API_READ_ACESS_TOKEN=...

# OMDB
OMDB_API_KEY=...

# OpenRouter (for script generation)
OPENROUTER_API_KEY=sk-or-...
